@page "/employees"
@attribute [Authorize]
@inject IEmployeeClient EmployeeClient
@inject ISkillClient SkillClient

<PageTitle>Employees</PageTitle>

<h1>Employees</h1>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
    <div>
        <label class="form-label" for="employee-skill-filter">Skill Filter</label>
        <InputSelect id="employee-skill-filter" class="form-select" style="max-width: 320px;" @bind-Value="selectedSkillId" disabled="@isLoading">
            <option value="">All skills</option>
            @foreach (var skill in skills)
            {
                <option value="@skill.Id">@skill.Name</option>
            }
        </InputSelect>
    </div>

    <div class="d-flex flex-wrap justify-content-end gap-2">
        <button class="btn btn-outline-secondary" @onclick="ApplyFilterAsync" disabled="@isLoading">Apply Filter</button>
        <button class="btn btn-outline-secondary" @onclick="ClearFilterAsync" disabled="@isLoading || selectedSkillId is null">Clear</button>
        <button class="btn btn-outline-primary" @onclick="LoadEmployeesAsync" disabled="@isLoading">
            @(isLoading ? "Loading..." : "Reload")
        </button>
        <button class="btn btn-primary" @onclick="ToggleCreateForm" disabled="@(isLoading || isSubmitting)">
            @(showCreateForm ? "Cancel" : "New Employee")
        </button>
    </div>
</div>

@if (showCreateForm)
{
    <EditForm Model="employeeDraft" OnValidSubmit="CreateEmployeeAsync" class="card card-body mb-3">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label" for="employee-first-name">First Name</label>
                <InputText id="employee-first-name" class="form-control" @bind-Value="employeeDraft.FirstName" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="employee-last-name">Last Name</label>
                <InputText id="employee-last-name" class="form-control" @bind-Value="employeeDraft.LastName" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="employee-email">Email</label>
                <InputText id="employee-email" class="form-control" @bind-Value="employeeDraft.Email" />
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-success" disabled="@isSubmitting">@(isSubmitting ? "Saving..." : "Save Employee")</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="ToggleCreateForm" disabled="@isSubmitting">Close</button>
        </div>
    </EditForm>
}

@if (isLoading)
{
    <p><em>Loading employees...</em></p>
}
else if (employees.Count == 0)
{
    <p>No employees were found.</p>
}
else
{
    <ResourceGrid Items="employees" EmptyMessage="No employees were found.">
        <HeaderTemplate>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
        </HeaderTemplate>
        <RowTemplate Context="employee">
            <td>@employee.FirstName</td>
            <td>@employee.LastName</td>
            <td>@employee.Email</td>
        </RowTemplate>
    </ResourceGrid>
}

@code {
    private readonly List<Employee> employees = [];
    private readonly List<Skill> skills = [];
    private readonly Employee employeeDraft = new();
    private Guid? selectedSkillId;

    private bool isLoading;
    private bool isSubmitting;
    private bool showCreateForm;

    private string? errorMessage;
    private string? successMessage;

    protected override Task OnInitializedAsync()
    {
        // Interactive Auto renders once on the server, then hydrates in-browser.
        // Only load API data in-browser to avoid transient prerender errors.
        if (!OperatingSystem.IsBrowser())
        {
            return Task.CompletedTask;
        }

        return LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var employeesTask = EmployeeClient.GetEmployeesAsync(selectedSkillId?.ToString(), true);
            var skillsTask = SkillClient.GetSkillsAsync();

            await Task.WhenAll(employeesTask, skillsTask);

            var employeesData = await employeesTask;
            var skillsData = await skillsTask;

            employees.Clear();
            employees.AddRange(employeesData);

            skills.Clear();
            skills.AddRange(skillsData);
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load employees: {ex.Message}";
            employees.Clear();
            skills.Clear();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadEmployeesAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var data = await EmployeeClient.GetEmployeesAsync(selectedSkillId?.ToString(), true);
            employees.Clear();
            employees.AddRange(data);
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load employees: {ex.Message}";
            employees.Clear();
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task ApplyFilterAsync()
    {
        return LoadEmployeesAsync();
    }

    private Task ClearFilterAsync()
    {
        selectedSkillId = null;
        return LoadEmployeesAsync();
    }

    private void ToggleCreateForm()
    {
        showCreateForm = !showCreateForm;
        errorMessage = null;
        successMessage = null;

        if (!showCreateForm)
        {
            employeeDraft.FirstName = string.Empty;
            employeeDraft.LastName = string.Empty;
            employeeDraft.Email = string.Empty;
        }
    }

    private async Task CreateEmployeeAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var createdEmployee = await EmployeeClient.CreateEmployeeAsync(employeeDraft);
            if (createdEmployee is not null)
            {
                employees.Add(createdEmployee);
            }

            successMessage = "Employee created successfully.";
            showCreateForm = false;
            employeeDraft.FirstName = string.Empty;
            employeeDraft.LastName = string.Empty;
            employeeDraft.Email = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to create employee: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
