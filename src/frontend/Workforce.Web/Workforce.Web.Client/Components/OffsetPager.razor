@if (TotalPages is > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination mb-0">
            <li class="page-item @(CurrentPage <= 1 ? "disabled" : null)">
                <button class="page-link" disabled="@(IsLoading || CurrentPage <= 1)" @onclick="() => ChangePageAsync(CurrentPage - 1)">Previous</button>
            </li>

            @for (var page = 1; page <= TotalPages; page++)
            {
                var pageNumber = page;
                <li class="page-item @(pageNumber == CurrentPage ? "active" : null)">
                    <button class="page-link" disabled="@IsLoading" @onclick="() => ChangePageAsync(pageNumber)">@pageNumber</button>
                </li>
            }

            <li class="page-item @(CurrentPage >= TotalPages ? "disabled" : null)">
                <button class="page-link" disabled="@(IsLoading || CurrentPage >= TotalPages)" @onclick="() => ChangePageAsync(CurrentPage + 1)">Next</button>
            </li>
        </ul>
    </nav>
}

@code {
    [Parameter]
    public int CurrentPage { get; set; } = 1;

    [Parameter]
    public int? TotalPages { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback<int> OnPageChange { get; set; }

    private async Task ChangePageAsync(int page)
    {
        if (page < 1 || page == CurrentPage || (TotalPages.HasValue && page > TotalPages))
            return;

        await OnPageChange.InvokeAsync(page);
    }
}
